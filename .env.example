# NOTE: the backend does not load a .env file automatically (no dotenv/ConfigModule).
# These values are the defaults already built into the code, listed here for reference.
# Variable names below match what backend/src/app.module.ts actually reads.

# Backend
PORT=3000
JWT_SECRET=assessment-secret

# Database (Docker maps MySQL to host port 3307, see docker-compose.yml)
DB_HOST=localhost
DB_PORT=3307
DB_USER=assessment
DB_PASSWORD=assessment
DB_NAME=assessment

# Frontend (the frontend currently uses a hard-coded http://localhost:3000 in src/api/client.ts)
VITE_API_BASE_URL=http://localhost:3000
